---
interface Props {
  category: string;
  class?: string;
}

const { category, class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-block align-middle text-[11px] leading-none font-normal px-2 py-1 rounded-full bg-surface text-muted border border-line whitespace-nowrap",
    className,
  ]}
>
  {category}
</span>
