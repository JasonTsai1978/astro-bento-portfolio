---
import { formatDate } from "../../lib/helpers";
import CategoryTag from "./CategoryTag.astro";

interface Props {
  title: string;
  date: Date;
  id: string;
  category: string;
}

const { title, date, id, category } = Astro.props;
---

<li
  class="list-none w-full text-ink hover:text-accent ease-in-out transition-colors border-b-line border-solid border-b-1"
>
  <a
    class="text-base decoration-none flex justify-between gap-4 py-3"
    href={`/blog/${id}`}
  >
    <p class="m-0">
      {title}
      <CategoryTag category={category} class="ml-1" />
    </p>
    <time
      class="text-right text-sm tabular-nums shrink-0 text-muted"
      data-date={date.toISOString()}       datetime={date.toISOString()}
    >
      {formatDate(date)}
    </time>
  </a>
</li>
