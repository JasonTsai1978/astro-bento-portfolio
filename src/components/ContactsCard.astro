---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
---
<script>
  // 每秒更新台北當地時間（原 Time zone 卡片併入此處）
  function updateLocalTime() {
    const el = document.getElementById("localTime");
    if (!el) return;
    const now = new Date();
    el.textContent =
      now.toLocaleTimeString("en-US", { timeZone: "Asia/Taipei", hour: "numeric", minute: "2-digit" }) +
      " (UTC+8)";
    el.setAttribute("datetime", now.toISOString());
  }
  updateLocalTime();
  setInterval(updateLocalTime, 1000);
</script>

<Card colSpan="md:col-span-1" rowSpan="md:row-span-3">
  <div class="h-full">
    <header class="flex items-center">
      <h1 class="text-white text-xl font-bold">
        Let's connect.
      </h1>
    </header>
    <address class="flex flex-col mt-4 not-italic">
      <h2 class="text-sm text-gray-500">Location</h2>
      <p class="text-sm">Hsinchu, Taiwan</p>
      <time class="text-sm text-gray-400 tabular-nums" datetime="" id="localTime"></time>
    </address>
    <div class="flex flex-col mt-4 w-fit">
      <h2 class="text-sm text-gray-500">Socials</h2>
      <ul class="flex flex-col gap-1 text-sm">
        <li>
          <a href={LINKS.linkedin} target="_blank" class="hover:text-white transition-colors">LinkedIn</a>
        </li>
        <li>
          <a href={LINKS.github} target="_blank" class="hover:text-white transition-colors">GitHub</a>
        </li>
        <li>
          <a href={`mailto:${LINKS.email}`} class="hover:text-white transition-colors">Email</a>
        </li>
      </ul>
    </div>
    <div class="flex flex-col mt-4">
      <h2 class="text-sm text-gray-500">Currently open to</h2>
      <ul class="flex flex-col gap-1 text-sm">
        <li>💬 Industry conversations</li>
        <li>🤝 AI & automation collaboration</li>
        <li>📩 Speaking & advisory</li>
      </ul>
    </div>
  </div>
</Card>
