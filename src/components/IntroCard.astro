---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { LINKS } from "../lib/constants";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
---
<Card colSpan="md:col-span-2 lg:col-span-3" rowSpan="lg:row-span-4">
  <div class="flex flex-col-reverse gap-4 w-full h-full md:flex-row">
    <div class="flex flex-col justify-between md:max-h-[300px] gap-4">
      <div class="flex flex-col h-full gap-2">
        <h6 class="text-sm font-light m-0 text-gray-500">welcome</h6>
        <p class="m-0 font-light text-xl">
          Hi, I'm <b class="font-bold">Jason Tsai</b>
        </p>
        <p class="m-0 font-light text-base text-gray-300 leading-relaxed">
          By day: IT Manager keeping <b class="font-semibold">Tier-1 semiconductor operations</b> online.<br />
          By night: building with <b class="font-semibold">Claude Code</b>, Claude, Gemini and ChatGPT — automating my own work first, then bringing what works to my team.
        </p>
      </div>
      <div class="flex gap-4 flex-wrap">
        <a aria-label="github profile" href={LINKS.github} target="_blank">
          <Button aria-label="github profile">
            <Icon class="h-6" name="ri:github-fill" />
            <span class="sr-only">GitHub Profile</span>
          </Button>
        </a>
        <a aria-label="linkedin profile" href={LINKS.linkedin} target="_blank">
          <Button aria-label="linkedin profile">
            <Icon class="h-6" name="ri:linkedin-box-fill" />
            <span class="sr-only">LinkedIn Profile</span>
          </Button>
        </a>
      </div>
    </div>
    <Image
      alt="Jason Tsai"
      class="w-24 h-24 rounded-full object-cover object-top select-none md:w-auto md:h-auto md:max-h-[300px] md:rounded-none pointer-events-none"
      height="300"
      src="/JasonTsai.webp"
      width="300"
    />
  </div>
</Card>
