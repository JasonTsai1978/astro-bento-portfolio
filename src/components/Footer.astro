<footer class="site-footer">
  <div class="wrap row">
    <p>
      © <span id="copyright-year">{new Date().getFullYear()}</span> Jason Tsai · Built with
      <a href="https://astro.build/" rel="noopener" target="_blank">Astro</a>
    </p>
    <p>
      <a href="/blog/">Writing</a> · <a href="/travel/">Travel</a> · <a href="/rss.xml">RSS</a>
    </p>
  </div>
  <!-- build 時已帶入年份；瀏覽器端再更新一次，跨年沒重新部署也正確 -->
  <script is:inline>
    document.getElementById("copyright-year").textContent = new Date().getFullYear();
  </script>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 24px;
  }
  p {
    margin: 0;
  }
  a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  a:hover {
    text-decoration-color: var(--accent);
  }
</style>
