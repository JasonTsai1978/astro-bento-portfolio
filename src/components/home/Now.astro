---
import SectionHead from "./SectionHead.astro";
import Globe from "../Globe";
---

<section class="section wrap" id="now">
  <SectionHead label="Now" no="05" title="What I'm up to." />
  <p class="updated">
    <span aria-hidden="true" class="pulse"></span>
    Updated October 2026 ·
    <a href="https://sive.rs/now" rel="noopener" target="_blank">what's a now page?</a>
  </p>
  <div class="cols">
    <div>
      <h3 class="label">At work</h3>
      <p>Getting my dev team comfortable using AI on real tasks, within the guardrails a semiconductor fab requires.</p>
    </div>
    <div>
      <h3 class="label">On the side</h3>
      <p>
        My personal lab. A 2016 MacBook now runs as an always-on Claude Code agent and briefs me on the chip industry
        every weekday at 7:30. My notes live in a personal knowledge system on Obsidian.
      </p>
    </div>
    <div>
      <h3 class="label">Off the clock</h3>
      <p>Strength training and eating clean. Stay strong, stay healthy.</p>
    </div>
  </div>

  <a class="travel" href="/travel/">
    <span class="text">
      <span class="label">Off the map</span>
      <span class="title">Countries I visited <span aria-hidden="true">→</span></span>
    </span>
    <span aria-hidden="true" class="globe">
      <Globe client:visible />
    </span>
  </a>
</section>

<style>
  .updated {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: -16px 0 32px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .updated a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 1px var(--line);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--sun) 70%, transparent);
    }
    100% {
      box-shadow: 0 0 0 12px transparent;
    }
  }
  .cols {
    display: grid;
    gap: 28px;
  }
  .cols h3 {
    margin-bottom: 10px;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
  }
  .cols p {
    margin: 0;
  }
  .travel {
    position: relative;
    display: flex;
    align-items: flex-start;
    height: 220px;
    margin-top: 48px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    transition: border-color 0.2s;
  }
  .travel:hover {
    border-color: var(--accent);
  }
  .text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 6px;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  /* 地球固定 500px 高，卡片只露出上半球 */
  .globe {
    position: absolute;
    top: 64px;
    right: -84px;
    width: 500px;
    transform: scale(0.62);
    transform-origin: top right;
    max-width: none;
    pointer-events: none;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }
    .travel {
      align-items: flex-end;
    }
    .globe {
      top: 24px;
      right: 6%;
      transform: none;
    }
  }
</style>
