---
import { getCollection } from "astro:content";
import SectionHead from "./SectionHead.astro";

// 同一篇文章的中英文版合併成一列：英文為主，中文標題放副標
const all = await getCollection("blog");
const byId = new Map(all.map((p) => [p.id, p]));
const posts = all
  .filter((p) => !p.id.endsWith("-zh") || !byId.has(p.id.slice(0, -3)))
  .map((p) => ({
    post: p,
    zh: p.id.endsWith("-zh") ? undefined : byId.get(`${p.id}-zh`),
  }))
  .sort((a, b) => (b.post.data.pubDate || new Date()).getTime() - (a.post.data.pubDate || new Date()).getTime())
  .slice(0, 5);

const shortDate = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<section class="section wrap" id="writing">
  <SectionHead
    intro="Notes on enterprise IT, bringing AI into a dev team, and what I build in my personal lab. Every post is in English and 中文."
    label="Writing"
    no="04"
    title="Latest posts."
  />
  {!posts.length && <p>First posts coming soon.</p>}
  <ul class="posts">
    {
      posts.map(({ post, zh }) => (
        <li>
          <p class="meta label">
            {post.data.pubDate && <time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>}
            <span class="cat">{post.data.category}</span>
          </p>
          <div>
            <h3>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            {zh && (
              <p class="zh">
                <a href={`/blog/${zh.id}/`} hreflang="zh-Hant" lang="zh-Hant">
                  {zh.data.title}
                </a>
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
  <p class="more">
    <a href="/blog/">All posts <span aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .posts li {
    display: grid;
    gap: 8px;
    padding-block: 22px;
    border-top: 1px solid var(--line);
  }
  .posts li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
  }
  .cat::before {
    content: "· ";
  }
  h3 {
    font-weight: 700;
    font-size: clamp(1.1875rem, 1.1rem + 0.5vw, 1.4375rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  h3 a,
  .zh a {
    transition: color 0.15s;
  }
  h3 a:hover,
  .zh a:hover {
    color: var(--accent);
  }
  .zh {
    margin: 6px 0 0;
    color: var(--muted);
  }
  .zh a {
    display: inline-block;
    padding-block: 4px;
  }
  .more {
    margin: 28px 0 0;
    font-weight: 600;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--accent);
  }
  .more a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 900px) {
    .posts li {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 24px;
      align-items: baseline;
    }
    .meta {
      flex-direction: column;
    }
    .cat::before {
      content: none;
    }
  }
</style>
