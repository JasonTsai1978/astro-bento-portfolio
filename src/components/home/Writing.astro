---
import SectionHead from "./SectionHead.astro";
import { getPostPairs, shortDate } from "../../lib/posts";

// 首頁只列最新 4 篇（中英文版已合併成一列）
const posts = (await getPostPairs()).slice(0, 4);
---

<section class="section wrap" id="writing">
  <SectionHead
    intro="Enterprise IT, bringing AI into a dev team, and what I build in my personal lab. Every post is in English and 中文."
    label="Writing"
    no="04"
    title="Latest posts."
  />
  {!posts.length && <p>First posts coming soon.</p>}
  <ul class="posts">
    {
      posts.map(({ post, zh }) => (
        <li>
          {post.data.pubDate && (
            <time class="label date" datetime={post.data.pubDate.toISOString()}>
              {shortDate(post.data.pubDate)}
            </time>
          )}
          <div class="titles">
            <h3>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            {zh && (
              <p class="zh">
                <a href={`/blog/${zh.id}/`} hreflang="zh-Hant" lang="zh-Hant">
                  {zh.data.title}
                </a>
              </p>
            )}
          </div>
          <span class="label cat">{post.data.category}</span>
        </li>
      ))
    }
  </ul>
  <p class="more">
    <a href="/blog/">All posts <span aria-hidden="true">→</span></a>
  </p>
</section>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .posts li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 12px;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }
  .posts li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .titles {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  .cat {
    text-align: right;
  }
  h3 {
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  h3 a,
  .zh a {
    transition: color 0.15s;
  }
  h3 a:hover,
  .zh a:hover {
    color: var(--accent);
  }
  .zh {
    margin: 2px 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .zh a {
    display: inline-block;
    padding-block: 3px;
  }
  .more {
    margin: 12px 0 0;
    font-weight: 600;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--accent);
  }
  .more a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 900px) {
    .posts li {
      grid-template-columns: 120px minmax(0, 1fr) auto;
      gap: 24px;
      align-items: baseline;
      padding-block: 16px;
    }
    .titles {
      grid-column: auto;
      grid-row: auto;
    }
    h3 {
      font-size: 1.1875rem;
    }
  }
</style>
