---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
---
<Card colSpan="lg:col-span-2" rowSpan="md:row-span-2">
  <div class="flex justify-between w-full items-start mb-2">
    <div class="flex flex-col">
      <h2>Now</h2>
      <a href="https://sive.rs/now" target="_blank">
        <span class="text-xs text-gray-500 cursor-pointer">what's that?</span>
      </a>
    </div>
    <Pulse />
  </div>
  <div class="flex flex-col gap-2">
    <p class="text-xs">Leading IT & System Integration at a Tier-1 semiconductor company in Hsinchu, Taiwan.</p>
    <p class="text-xs">Bringing AI into my 10-person dev team's daily workflow — security and compliance first.</p>
    <p class="text-xs">Running an always-on <b class="font-semibold">Claude Code</b> agent on a recycled MacBook, with a semiconductor news brief landing on my phone every weekday morning.</p>
  </div>
</Card>
