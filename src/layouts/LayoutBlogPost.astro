---
import { Image } from "astro:assets";
import photo from "../assets/JasonTsai.webp";
import { LINKS } from "../lib/constants";
import { categorySlug } from "../lib/posts";
import BasicLayout from "./BasicLayout.astro";

type PostLink = { href: string; title: string };

type Props = {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  minutesRead: string;
  url: string;
  lang?: string;
  alternates?: { lang: string; href: string }[];
  // 兩個語言版本都存在時才傳，用來畫語言切換鈕
  enHref?: string;
  zhHref?: string;
  // 連載集數（例如 "Ep 1"），不是連載就不傳
  series?: string;
  older?: PostLink;
  newer?: PostLink;
};

const { title, description, pubDate, category, minutesRead, url, lang, alternates, enHref, zhHref, series, older, newer } =
  Astro.props;

const zh = lang === "zh-Hant";
const hasSwitch = Boolean(enHref && zhHref);

// 介面文字跟著文章語言走；文章內文不在這裡
const minutes = parseInt(minutesRead, 10);
const t = zh
  ? {
      back: "所有文章",
      date: pubDate.toLocaleDateString("zh-TW", { year: "numeric", month: "long", day: "numeric" }),
      read: Number.isFinite(minutes) ? `約 ${minutes} 分鐘` : minutesRead,
      switchLabel: "切換語言",
      nav: "其他文章",
      older: "上一篇",
      newer: "下一篇",
      by: "作者",
      bio: "半導體製造業 IT Manager。新東西先在自己的工作上試，留得下來的才帶進團隊。",
      about: "關於我",
    }
  : {
      back: "All posts",
      date: pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }),
      read: minutesRead,
      switchLabel: "Language",
      nav: "More posts",
      older: "Older",
      newer: "Newer",
      by: "Written by",
      bio: "IT Manager in semiconductor manufacturing. I try everything on my own work first. What survives gets brought to the team.",
      about: "About me",
    };
---

<BasicLayout
  alternates={alternates}
  description={description}
  headline={title}
  lang={lang}
  page="blog"
  pubDate={pubDate}
  slug={url}
  title={`${title} | Jason Tsai`}
>
  <main class="wrap page" id="main">
    <div class="col">
      <header class="head">
        <p class="top">
          <a class="back" href="/blog/"><span aria-hidden="true">←</span> {t.back}</a>
          <span class="tags">
            {series && <span class="label series">Lobster · {series}</span>}
            <a class="label cat" href={`/blog/#${categorySlug(category)}`}>{category}</a>
          </span>
        </p>
        <h1>{title}</h1>
        <div class="meta">
          <p class="label when">
            <time datetime={pubDate.toISOString()}>{t.date}</time>
            <span aria-hidden="true">·</span>
            {t.read}
          </p>
          {
            hasSwitch && (
              <nav aria-label={t.switchLabel} class="lang">
                <a aria-current={zh ? undefined : "page"} href={enHref} hreflang="en" lang="en">
                  EN
                </a>
                <a aria-current={zh ? "page" : undefined} href={zhHref} hreflang="zh-Hant" lang="zh-Hant">
                  中文
                </a>
              </nav>
            )
          }
        </div>
      </header>

      <article class:list={["post", { "has-switch": hasSwitch, zh }]}>
        <slot />
      </article>

      {
        (older || newer) && (
          <nav aria-label={t.nav} class="pager">
            {older ? (
              <a class="older" href={older.href} rel="prev">
                <span class="label">
                  <span aria-hidden="true">←</span> {t.older}
                </span>
                <span class="ttl">{older.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="newer" href={newer.href} rel="next">
                <span class="label">
                  {t.newer} <span aria-hidden="true">→</span>
                </span>
                <span class="ttl">{newer.title}</span>
              </a>
            )}
          </nav>
        )
      }

      <aside class="author">
        <Image alt="" class="face" height={144} loading="lazy" src={photo} width={144} />
        <div>
          <p class="label">{t.by}</p>
          <p class="name">Jason Tsai</p>
          <p class="bio">{t.bio}</p>
          <p class="links">
            <a href="/#about">{t.about}</a>
            <a href={LINKS.linkedin} rel="noopener" target="_blank">LinkedIn <span aria-hidden="true">↗</span></a>
            <a href="/rss.xml">RSS</a>
          </p>
        </div>
      </aside>
    </div>
  </main>
</BasicLayout>

<style>
  .page {
    padding-block: clamp(24px, 4vw, 48px) clamp(48px, 7vw, 88px);
  }
  /* 閱讀欄：英文約 70 個字元一行 */
  .col {
    max-width: 720px;
    margin-inline: auto;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    margin: 0 0 clamp(16px, 3vw, 28px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }
  .back:hover,
  .cat:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .series {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--sun);
    color: var(--sun-ink);
  }
  .cat {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(1.875rem, 1.35rem + 2.6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  :global(html[lang="zh-Hant"]) h1 {
    line-height: 1.25;
    letter-spacing: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin: clamp(14px, 2vw, 20px) 0 clamp(24px, 4vw, 36px);
    padding-bottom: clamp(14px, 2vw, 20px);
    border-bottom: 1px solid var(--line);
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin: 0;
  }

  /* 語言切換：兩段式膠囊，目前的語言反白 */
  .lang {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .lang a:hover {
    color: var(--ink);
  }
  .lang a[aria-current="page"] {
    background: var(--ink);
    color: var(--bg);
  }

  /* 上下篇 */
  .pager {
    display: grid;
    gap: 12px;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .pager a {
    display: grid;
    gap: 6px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .pager a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .pager .newer {
    text-align: right;
  }
  .ttl {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  /* 作者卡 */
  .author {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    padding: 20px;
    border-radius: 16px;
    background: var(--surface);
  }
  .author :global(.face) {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .author p {
    margin: 0;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1875rem;
    line-height: 1.3;
  }
  .bio {
    margin-top: 4px !important;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-top: 6px !important;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    color: var(--accent);
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 640px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
    .author {
      gap: 20px;
      padding: 24px;
    }
    .author :global(.face) {
      width: 72px;
      height: 72px;
    }
  }
</style>
