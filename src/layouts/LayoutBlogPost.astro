---
import { formatDate } from "../lib/helpers";
import BasicLayout from "./BasicLayout.astro";
import CategoryTag from "../components/Blog/CategoryTag.astro";

type Props = {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  minutesRead: string;
  url: string;
  lang?: string;
  alternates?: { lang: string; href: string }[];
};

const { title, description, pubDate, category, minutesRead, url, lang, alternates } = Astro.props;
---

<BasicLayout
  alternates={alternates}
  description={description}
  headline={title}
  lang={lang}
  page="blog"
  pubDate={pubDate}
  slug={url}
  title={`${title} | Jason Tsai`}
>
  <main class="mx-auto max-w-3xl w-full px-5 pt-10 pb-24 md:px-8 md:pt-16 text-ink" id="main">
    <a class="text-sm font-semibold text-accent hover:underline" href="/blog/">← All posts</a>
    <div class="mt-6 mb-10">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">{title}</h1>
      <div class="flex justify-between pt-4 text-muted text-sm">
        <div class="flex items-start gap-2">
          <p>{formatDate(pubDate)}</p>
          <CategoryTag category={category} />
        </div>
        <p>{minutesRead}</p>
      </div>
    </div>
    <article class="post">
      <slot />
    </article>
  </main>
</BasicLayout>
