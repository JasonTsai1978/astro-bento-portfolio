---
import { LINKS } from "../lib/constants";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  page?: "travel" | "blog";
  slug?: string | undefined;
  pubDate?: Date;
  // 文章原標題（不含站名），給 JSON-LD headline 用
  headline?: string;
  lang?: string;
  // 同一篇文章的各語言版本，輸出 hreflang
  alternates?: { lang: string; href: string }[];
  noindex?: boolean;
}

const {
  title,
  description,
  page,
  pubDate,
  headline,
  lang = "en",
  alternates = [],
  noindex = false,
} = Astro.props;
const isPost = page === "blog" && !!pubDate;
const ogLocale = (l: string) => (l === "zh-Hant" ? "zh_TW" : "en_US");
const image =
  page === "travel"
    ? `${Astro.url.origin}/og-image.png`
    : `${Astro.url.origin}/og-image.png`;

const schema =
  page !== "blog"
    ? {
        "@context": "http://schema.org",
        "@type": "Person",
        name: "Jason Tsai",
url: Astro.url.origin,
sameAs: [LINKS.linkedin, LINKS.github],
image: `${Astro.url.origin}/og-image.png`,
jobTitle: "IT Manager",
worksFor: {
  "@type": "Organization",
  name: "Tier-1 Semiconductor Company",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Hsinchu",
    addressCountry: "TW",
  },
},
nationality: {
  "@type": "Country",
  name: "Taiwan",
},
      }
    : {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": Astro.url.href,
        },
        headline: headline || title,
        inLanguage: lang,
        description: description || title,
        image: `${Astro.url.origin}/og-image.png`, //TODO: dynamic
        author: {
          "@type": "Person",
          name: "Jason Tsai",
          url: Astro.url.origin,
          sameAs: [LINKS.linkedin, LINKS.github],
        },
        publisher: {
          "@type": "Organization",
          name: "Jason Tsai",
          logo: {
            "@type": "ImageObject",
            url: `${Astro.url.origin}/og-image.png`,
          },
        },
        datePublished: pubDate?.toISOString(),
        dateModified: pubDate?.toISOString(),
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="light dark" name="color-scheme" />
    <meta content="#FFFDF8" name="theme-color" />
    <!-- 在畫面出現前決定主題：手動選過的優先，否則跟隨系統設定 -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        function saved() {
          try {
            var v = localStorage.getItem("theme");
            return v === "day" || v === "night" ? v : null;
          } catch (e) {
            return null;
          }
        }
        function set(theme) {
          root.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = theme === "night" ? "#0E1528" : "#FFFDF8";
        }
        set(saved() || (mq.matches ? "night" : "day"));
        mq.addEventListener("change", function (e) {
          if (!saved()) set(e.matches ? "night" : "day");
        });
        window.__setTheme = set;
      })();
    </script>
    <link as="font" crossorigin href="/fonts/CabinetGrotesk-Variable.woff2" rel="preload" type="font/woff2" />
    <link as="font" crossorigin href="/fonts/Satoshi-Variable.woff2" rel="preload" type="font/woff2" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <meta content={Astro.generator} name="generator" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content={noindex ? "noindex, follow" : "index, follow"} name="robots" />
    <!-- Basic OG tags for sharing your website's content on platforms like Facebook and LinkedIn -->
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={isPost ? "article" : "website"} property="og:type" />
    <meta content={Astro.url.href} property="og:url" />
    <meta content={ogLocale(lang)} property="og:locale" />
    {
      alternates
        .filter((a) => a.lang !== lang)
        .map((a) => <meta content={ogLocale(a.lang)} property="og:locale:alternate" />)
    }
    {isPost && <meta content={pubDate!.toISOString()} property="article:published_time" />}
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      property="og:image"
    />
    <!-- Basic Twitter Card tags -->
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta
      content={image || `${Astro.url.origin}/og-image.png`}
      name="twitter:image"
    />

    <link href={Astro.url.href} rel="canonical" />
    <link href="/rss.xml" rel="alternate" title="Jason Tsai's Blog" type="application/rss+xml" />
    {alternates.map((a) => <link href={a.href} hreflang={a.lang} rel="alternate" />)}
    {
      alternates.length > 0 && (
        <link href={alternates.find((a) => a.lang === "en")?.href} hreflang="x-default" rel="alternate" />
      )
    }
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
