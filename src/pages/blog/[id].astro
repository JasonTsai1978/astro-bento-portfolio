---
import { getEntry, render } from "astro:content";
import { getCollection } from "astro:content";
import LayoutBlogPost from "../../layouts/LayoutBlogPost.astro";
import { seriesEpisode } from "../../lib/posts";

export const prerender = true;

export async function getStaticPaths() {
  return (await getCollection("blog")).map(({ id }) => ({
    params: { id: id as string },
  }));
}

const { id } = Astro.params;

if (!id) {
  throw new Error("id is missing");
}

const entry = await getEntry("blog", id);

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, remarkPluginFrontmatter } = await render(entry);

// 中英文版互指：英文 id 為 x，中文為 x-zh；兩篇都存在才輸出 hreflang 與語言切換
const isZh = id.endsWith("-zh");
const enId = isZh ? id.slice(0, -3) : id;
const zhId = `${enId}-zh`;
const all = await getCollection("blog");
const ids = new Set(all.map((p) => p.id));
const postUrl = (postId: string) => new URL(`/blog/${postId}/`, Astro.site).href;
const paired = ids.has(enId) && ids.has(zhId);
const alternates = paired
  ? [
      { lang: "en", href: postUrl(enId) },
      { lang: "zh-Hant", href: postUrl(zhId) },
    ]
  : [];

// 上下篇：只在同一種語言裡依發佈日期排（舊 → 新），日期相同時依 id 排，結果才固定
const sameLang = all
  .filter((p) => p.id.endsWith("-zh") === isZh)
  .sort(
    (a, b) =>
      (a.data.pubDate || new Date()).getTime() - (b.data.pubDate || new Date()).getTime() || a.id.localeCompare(b.id),
  );
const at = sameLang.findIndex((p) => p.id === id);
const link = (p?: (typeof sameLang)[number]) => (p ? { href: `/blog/${p.id}/`, title: p.data.title || "" } : undefined);
---

<LayoutBlogPost
  alternates={alternates}
  category={entry.data.category}
  description={entry.data.description!}
  enHref={paired ? `/blog/${enId}/` : undefined}
  lang={isZh ? "zh-Hant" : "en"}
  minutesRead={remarkPluginFrontmatter.minutesRead}
  newer={link(sameLang[at + 1])}
  older={link(sameLang[at - 1])}
  pubDate={entry.data.pubDate!}
  series={seriesEpisode(entry.id)}
  title={entry.data.title}
  url={`blog/${entry.id}`}
  zhHref={paired ? `/blog/${zhId}/` : undefined}
>
  <Content />
</LayoutBlogPost>

<style is:global>
  article.post {
    font-size: 1.0625rem;
    line-height: 1.75;
    overflow-wrap: break-word;
  }

  /* 中文：行距放寬、字距微開，標題不用負字距 */
  article.post.zh {
    line-height: 1.9;
    letter-spacing: 0.01em;
  }

  @media (min-width: 900px) {
    article.post {
      font-size: 1.125rem;
    }
  }

  article.post > :first-child {
    margin-top: 0;
  }

  /* 內文第一行原本是「中文版／English version」連結；標題下方已有語言切換鈕，這行收起來（文章檔不改） */
  article.post.has-switch > p:first-child:has(> a:only-child[href^="/blog/"]) {
    display: none;
  }

  article.post.has-switch > p:first-child:has(> a:only-child[href^="/blog/"]) + * {
    margin-top: 0;
  }

  article.post :is(h1, h2, h3, h4, h5, h6) {
    margin-top: 2em;
    margin-bottom: 0.6em;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  article.post.zh :is(h1, h2, h3, h4, h5, h6) {
    line-height: 1.4;
    letter-spacing: 0;
  }

  article.post h1 {
    font-size: 1.75rem;
  }

  article.post h2 {
    font-size: 1.625rem;
  }

  article.post h3 {
    font-size: 1.3125rem;
  }

  article.post hr {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  article.post h4 {
    font-size: 20px;
  }

  article.post h5 {
    font-size: 18px;
  }

  article.post h6 {
    font-size: 16px;
  }

  article.post p {
    margin: 0 0 1em 0;
  }

  article.post a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 3px;
  }

  article.post a:hover {
    text-decoration-color: var(--accent);
  }

  article.post :is(ul, ol) {
    margin-left: 20px;
    margin-bottom: 1em;
    padding-left: 4px;
  }

  article.post ul {
    list-style: disc;
  }

  article.post ol {
    list-style: decimal;
  }

  article.post li {
    margin-bottom: 6px;
  }

  article.post blockquote {
    margin: 20px 0;
    padding-left: 15px;
    border-left: 4px solid var(--sun);
    color: var(--muted);
  }

  article.post :is(pre, code) {
    font-family: var(--font-mono);
    background-color: var(--surface);
    border-radius: 6px;
  }

  article.post pre {
    padding: 14px 16px;
    overflow-x: auto;
    border: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  article.post code {
    padding: 2px 5px;
    font-size: 90%;
    color: var(--ink);
  }

  article.post pre code {
    padding: 0;
    background: none;
    font-size: inherit;
  }

  article.post img {
    max-width: 100%;
    height: auto;
  }

  /* 文章內經 Astro 處理的照片：置中、圓角（不影響手寫 HTML 的 SVG 小圖）。
     不設 width:auto，讓 width/height 屬性在載入前就預留空間，避免版面跳動 */
  article.post img[src^="/_astro/"] {
    display: block;
    margin: 1.75em auto;
    border-radius: 12px;
  }

  /* 深色素材（流程圖 SVG、影片、仿 Telegram 對話框）在淺色頁面上加圖框，才不會像破了一個洞 */
  article.post img[src^="/blog/"][src$=".svg"][width="440"] {
    display: block;
    margin: 1.75em auto;
    border-radius: 16px;
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px -16px rgba(14, 21, 40, 0.45);
  }

  article.post video {
    display: block;
    margin: 1.75em 0;
    background: #0e1528;
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px -16px rgba(14, 21, 40, 0.45);
  }

  article.post > div[style*="background:#0e1621"] {
    box-shadow: 0 12px 32px -16px rgba(14, 21, 40, 0.45);
    letter-spacing: 0;
  }

  /* 仿 Telegram 對話框裡的灰色小字（bot、時間）原色 #6c7883 對比不足，調亮到 AA；文章檔不改所以用 !important 蓋過 inline style */
  article.post [style*="color:#6c7883"] {
    color: #93a0ad !important;
  }

  /* 直式照片：Markdown 中用 <div class="portrait"> 包住，寬度上限 390px（3:4 照片高度約 520px） */
  article.post .portrait img {
    max-width: min(100%, 390px);
  }

  article.post table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 1em;
    font-size: 0.9375rem;
  }

  article.post :is(th, td) {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  /* 手機：表格字級與內距縮小；還是放不下時表格自己左右捲，不撐寬整頁 */
  @media (max-width: 639px) {
    article.post table {
      display: block;
      overflow-x: auto;
      font-size: 0.875rem;
      line-height: 1.55;
    }

    article.post :is(th, td) {
      padding: 8px 6px;
    }

    article.post :is(th, td):first-child {
      padding-left: 0;
    }
  }
</style>
