---
import { getEntry, render } from "astro:content";
import { getCollection } from "astro:content";
import LayoutBlogPost from "../../layouts/LayoutBlogPost.astro";

export const prerender = true;

export async function getStaticPaths() {
  return (await getCollection("blog")).map(({ id }) => ({
    params: { id: id as string },
  }));
}

const { id } = Astro.params;

if (!id) {
  throw new Error("id is missing");
}

const entry = await getEntry("blog", id);

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, remarkPluginFrontmatter } = await render(entry);

// 中英文版互指：英文 id 為 x，中文為 x-zh；兩篇都存在才輸出 hreflang
const enId = id.endsWith("-zh") ? id.slice(0, -3) : id;
const zhId = `${enId}-zh`;
const ids = new Set((await getCollection("blog")).map((p) => p.id));
const postUrl = (postId: string) => new URL(`/blog/${postId}/`, Astro.site).href;
const alternates =
  ids.has(enId) && ids.has(zhId)
    ? [
        { lang: "en", href: postUrl(enId) },
        { lang: "zh-Hant", href: postUrl(zhId) },
      ]
    : [];
---

<LayoutBlogPost
  alternates={alternates}
  category={entry.data.category}
  description={entry.data.description!}   minutesRead={remarkPluginFrontmatter.minutesRead}   pubDate={entry.data.pubDate!}   lang={entry.id.endsWith("-zh") ? "zh-Hant" : "en"}   title={entry.data.title}   url={`blog/${entry.id}`}
>
  <Content />
</LayoutBlogPost>

<style is:global>
  article.post {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  article.post :is(h1, h2, h3, h4, h5, h6) {
    margin-top: 1.6em;
    margin-bottom: 0.5em;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  article.post h1 {
    font-size: 32px;
  }

  article.post h2 {
    font-size: 28px;
  }

  article.post h3 {
    font-size: 24px;
  }

  article.post h4 {
    font-size: 20px;
  }

  article.post h5 {
    font-size: 18px;
  }

  article.post h6 {
    font-size: 16px;
  }

  article.post p {
    margin: 0 0 1em 0;
  }

  article.post a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 3px;
  }

  article.post a:hover {
    text-decoration-color: var(--accent);
  }

  article.post :is(ul, ol) {
    margin-left: 20px;
    margin-bottom: 1em;
    padding-left: 4px;
  }

  article.post ul {
    list-style: disc;
  }

  article.post ol {
    list-style: decimal;
  }

  article.post li {
    margin-bottom: 6px;
  }

  article.post blockquote {
    margin: 20px 0;
    padding-left: 15px;
    border-left: 4px solid var(--sun);
    color: var(--muted);
  }

  article.post :is(pre, code) {
    font-family: var(--font-mono);
    background-color: var(--surface);
    border-radius: 6px;
  }

  article.post pre {
    padding: 14px 16px;
    overflow-x: auto;
    border: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  article.post code {
    padding: 2px 5px;
    font-size: 90%;
    color: var(--ink);
  }

  article.post pre code {
    padding: 0;
    background: none;
    font-size: inherit;
  }

  article.post img {
    max-width: 100%;
    height: auto;
  }

  /* 文章內經 Astro 處理的照片：置中、圓角（不影響手寫 HTML 的 SVG 小圖）。
     不設 width:auto，讓 width/height 屬性在載入前就預留空間，避免版面跳動 */
  article.post img[src^="/_astro/"] {
    display: block;
    margin: 0 auto;
    border-radius: 8px;
  }

  /* 直式照片：Markdown 中用 <div class="portrait"> 包住，寬度上限 390px（3:4 照片高度約 520px） */
  article.post .portrait img {
    max-width: min(100%, 390px);
  }

  article.post table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 1em;
    font-size: 0.9375rem;
  }

  article.post :is(th, td) {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
</style>
