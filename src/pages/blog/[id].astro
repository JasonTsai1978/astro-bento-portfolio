---
import { getEntry, render } from "astro:content";
import { getCollection } from "astro:content";
import LayoutBlogPost from "../../layouts/LayoutBlogPost.astro";

export const prerender = true;

export async function getStaticPaths() {
  return (await getCollection("blog")).map(({ id }) => ({
    params: { id: id as string },
  }));
}

const { id } = Astro.params;

if (!id) {
  throw new Error("id is missing");
}

const entry = await getEntry("blog", id);

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, remarkPluginFrontmatter } = await render(entry);

// 中英文版互指：英文 id 為 x，中文為 x-zh；兩篇都存在才輸出 hreflang
const enId = id.endsWith("-zh") ? id.slice(0, -3) : id;
const zhId = `${enId}-zh`;
const ids = new Set((await getCollection("blog")).map((p) => p.id));
const postUrl = (postId: string) => new URL(`/blog/${postId}/`, Astro.site).href;
const alternates =
  ids.has(enId) && ids.has(zhId)
    ? [
        { lang: "en", href: postUrl(enId) },
        { lang: "zh-Hant", href: postUrl(zhId) },
      ]
    : [];
---

<LayoutBlogPost
  alternates={alternates}
  category={entry.data.category}
  description={entry.data.description!}   minutesRead={remarkPluginFrontmatter.minutesRead}   pubDate={entry.data.pubDate!}   lang={entry.id.endsWith("-zh") ? "zh-Hant" : "en"}   title={entry.data.title}   url={`blog/${entry.id}`}
>
  <Content />
</LayoutBlogPost>

<style is:global>
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    margin-top: 20px;
    margin-bottom: 10px;
    font-weight: bold;
  }

  h1 {
    font-size: 32px;
  }

  h2 {
    font-size: 28px;
  }

  h3 {
    font-size: 24px;
  }

  h4 {
    font-size: 20px;
  }

  h5 {
    font-size: 18px;
  }

  h6 {
    font-size: 16px;
  }

  p {
    margin: 0 0 10px 0;
  }

  a {
    color: #ec7981;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  ul,
  ol {
    margin-left: 20px;
    margin-bottom: 10px;
    padding-left: 4px;
  }

  ul {
    list-style: disc;
  }

  ol {
    list-style: decimal;
  }

  li {
    margin-bottom: 6px;
  }

  blockquote {
    margin: 20px 0;
    padding-left: 15px;
    border-left: 5px solid #525252;
  }

  pre,
  code {
    font-family: "Courier New", monospace;
    background-color: #262626;
    border-radius: 5px;
  }

  pre {
    padding: 10px;
    overflow-x: auto;
  }

  code {
    padding: 2px 4px;
    font-size: 90%;
    color: #f3a3aa;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* 文章內經 Astro 處理的照片：置中、圓角（不影響手寫 HTML 的 SVG 小圖）。
     不設 width:auto，讓 width/height 屬性在載入前就預留空間，避免版面跳動 */
  article img[src^="/_astro/"] {
    display: block;
    margin: 0 auto;
    border-radius: 6px;
  }

  /* 直式照片：Markdown 中用 <div class="portrait"> 包住，寬度上限 390px（3:4 照片高度約 520px） */
  article .portrait img {
    max-width: min(100%, 390px);
  }

  table {
    border-collapse: collapse;
    width: 100%;
  }

  th,
  td {
    text-align: left;
    padding: 8px;
    border-bottom: 1px solid #404040;
  }
</style>
