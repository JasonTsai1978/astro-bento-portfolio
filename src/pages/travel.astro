---
import Globe from "../components/Globe";
import BasicLayout from "../layouts/BasicLayout.astro";
---

<BasicLayout
  description="Countries Jason Tsai has visited, on an interactive 3D globe."
  page="travel"
  title="Jason Tsai - Visited Countries"
>
  <main class="w-full max-w-3xl mx-auto px-5 py-10 md:px-8 md:py-16 text-ink" id="main">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-2">Countries I visited</h1>
    <p class="text-muted mb-6">Highlighted in red. The globe keeps turning.</p>
    <Globe client:load />
  </main>
</BasicLayout>
