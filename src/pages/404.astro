---
import BasicLayout from "../layouts/BasicLayout.astro";
---

<!-- Cloudflare Pages 偵測到 404.html 就會對不存在的網址回 404，而不是回首頁 -->
<BasicLayout
  description="This page doesn't exist."
  noindex
  title="Page not found | Jason Tsai"
>
  <main class="flex flex-col flex-1 items-center justify-center gap-6 px-5 py-24 text-center text-ink"
    id="main">
    <p class="text-7xl font-extrabold tracking-tight m-0">404</p>
    <p class="text-lg text-muted m-0">This page doesn't exist, or it moved.</p>
    <div class="flex gap-4">
      <a class="text-ink hover:border-ink px-5 py-3 border-1 border-solid border-line rounded-full font-semibold" href="/">Home</a>
      <a class="text-ink hover:border-ink px-5 py-3 border-1 border-solid border-line rounded-full font-semibold" href="/blog/">Blog</a>
    </div>
  </main>
</BasicLayout>
