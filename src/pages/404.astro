---
import BasicLayout from "../layouts/BasicLayout.astro";
import { getPostPairs } from "../lib/posts";

// 迷路的人給他三篇最新文章當出口
const posts = (await getPostPairs()).slice(0, 3);
---

<!-- Cloudflare Pages 偵測到 404.html 就會對不存在的網址回 404，而不是回首頁 -->
<BasicLayout description="This page doesn't exist." noindex title="Page not found | Jason Tsai">
  <main class="wrap page" id="main">
    <p class="label">Error 404</p>
    <h1>This page didn't <mark>survive</mark>.</h1>
    <p class="intro">The page doesn't exist, or it moved. Here's where to go next.</p>
    <p class="actions">
      <a class="primary" href="/">Back home</a>
      <a href="/blog/">All posts</a>
    </p>
    {
      posts.length > 0 && (
        <section aria-labelledby="latest">
          <h2 class="label" id="latest">
            Latest posts
          </h2>
          <ul class="posts">
            {posts.map(({ post, zh }) => (
              <li>
                <a class="en" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
                {zh && (
                  <a class="zh" href={`/blog/${zh.id}/`} hreflang="zh-Hant" lang="zh-Hant">
                    {zh.data.title}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BasicLayout>

<style>
  .page {
    max-width: calc(760px + var(--gutter) * 2);
    padding-block: clamp(40px, 8vw, 96px) clamp(48px, 7vw, 88px);
  }
  .label {
    margin: 0 0 12px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(2.25rem, 1.5rem + 3.6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  mark {
    background: var(--mark-bg);
    color: var(--mark-ink);
  }
  .intro {
    margin: 16px 0 0;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
  }
  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 600;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .actions a:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
  }
  .actions a.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }
  section {
    margin-top: clamp(40px, 6vw, 64px);
  }
  h2.label {
    font-weight: 400;
  }
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }
  .posts li {
    display: grid;
    gap: 2px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  .posts a {
    transition: color 0.15s;
  }
  .posts a:hover {
    color: var(--accent);
  }
  .en {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
  }
  .zh {
    padding-block: 3px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
